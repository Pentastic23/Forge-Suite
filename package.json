{
  "name": "forge-suite",
  "private": true,
  "version": "0.1.0",
  "description": "Forge Suite: Forge Hub launcher plus Forge Core, Balance Forge, Asset Forge and Pixel Forge.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "hub:dev": "pnpm --filter forge-hub tauri dev",
    "hub:build": "pnpm --filter forge-hub tauri build",
    "core:dev": "pnpm --filter forge-core tauri dev",
    "core:build": "pnpm --filter forge-core tauri build",
    "balance:dev": "pnpm --filter balance-forge tauri dev",
    "balance:build": "pnpm --filter balance-forge tauri build",
    "asset:dev": "pnpm --filter asset-forge tauri dev",
    "asset:build": "pnpm --filter asset-forge tauri build",
    "pixel:dev": "pnpm --filter pixel-forge tauri dev",
    "pixel:build": "pnpm --filter pixel-forge tauri build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && cargo test --workspace"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
