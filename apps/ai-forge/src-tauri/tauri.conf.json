{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Forge",
  "version": "0.1.0",
  "identifier": "com.forgesuite.ai",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1426",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Forge",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#1c2236",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "forge-app.json": "forge-app.json", "icons/icon.png": "icon.png" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["aiforge"], "name": "AI Forge project", "description": "AI Forge project" }
    ]
  }
}
