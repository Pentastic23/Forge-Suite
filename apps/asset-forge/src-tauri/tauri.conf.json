{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asset Forge",
  "version": "0.1.0",
  "identifier": "com.forgesuite.asset",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Asset Forge",
        "width": 1440,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 660,
        "backgroundColor": "#1c2236"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "forge-app.json": "forge-app.json", "icons/icon.png": "icon.png" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["assetforge"], "name": "Asset Forge project", "description": "Asset Forge project" }
    ]
  }
}
