{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel Forge",
  "version": "0.1.0",
  "identifier": "com.forgesuite.pixel",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pixel Forge",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#1c2236",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["pixelforge"], "name": "Pixel Forge project", "description": "Pixel Forge project" }
    ]
  }
}
