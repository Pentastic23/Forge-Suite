{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge Core",
  "version": "0.1.0",
  "identifier": "com.forgesuite.core",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forge Core",
        "width": 1320,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "backgroundColor": "#1c2236"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["forgecore"], "name": "Forge Core project", "description": "Forge Core project" }
    ]
  }
}
